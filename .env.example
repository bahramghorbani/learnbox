# Local-only sample values. Never commit real credentials.
APP_ENV=local
DATABASE_URL=postgres://learnbox:learnbox@localhost:5432/learnbox
REDIS_URL=redis://localhost:6379
OTP_DEVELOPMENT_MODE=false
# SMS.ir delivery remains disabled until its template and restricted key are configured in the
# deployment secret store. Never put real values in this file or browser-exposed variables.
SMS_IR_ENABLED=false
LEARNBOX_OTP_TEST_UI_ENABLED=false
# SMS_IR_API_KEY=
# Approved LearnBox verification template (non-secret).
SMS_IR_TEMPLATE_ID=495140
SMS_IR_CODE_PARAMETER_NAME=OTP
# Independent server-side HMAC key for OTP phone/code hashes.
LEARNBOX_OTP_SECRET=replace-with-a-local-32-character-minimum-secret
LEARNBOX_SESSION_SECRET=replace-with-a-local-32-character-minimum-secret
LEARNBOX_ENABLE_DEVELOPMENT_SESSION=false
LEARNBOX_PRIVATE_MEDIA_ATTACHMENT_ENABLED=false
