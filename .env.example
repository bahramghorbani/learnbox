# Local-only sample values. Never commit real credentials.
APP_ENV=local
DATABASE_URL=postgres://learnbox:learnbox@localhost:5432/learnbox
REDIS_URL=redis://localhost:6379
OTP_DEVELOPMENT_MODE=false
# SMS.ir delivery remains disabled until its template and restricted key are configured in the
# deployment secret store. Never put real values in this file or browser-exposed variables.
SMS_IR_ENABLED=false
NEXT_PUBLIC_LEARNBOX_OTP_UI_ENABLED=false
LEARNBOX_OTP_TEST_UI_ENABLED=false
# SMS_IR_API_KEY=
# Approved LearnBox verification template (non-secret).
SMS_IR_TEMPLATE_ID=495140
SMS_IR_CODE_PARAMETER_NAME=OTP
# Independent server-side HMAC key for OTP phone/code hashes.
LEARNBOX_OTP_SECRET=replace-with-a-local-32-character-minimum-secret
LEARNBOX_SESSION_SECRET=replace-with-a-local-32-character-minimum-secret
LEARNBOX_ENABLE_DEVELOPMENT_SESSION=false
# Learner selection and server delivery are separate release gates. Keep both false until the
# authenticated alpha journey is explicitly approved for deployment.
NEXT_PUBLIC_LEARNBOX_PRIVATE_MEDIA_ENABLED=false
LEARNBOX_PRIVATE_MEDIA_ATTACHMENT_ENABLED=false

# Closed-alpha invitation and consent boundary, disabled by default. Codes are hashed with a
# server key; plaintext codes are never committed or logged. The consent version is read from
# config/closed-alpha.json unless overridden in the deployment secret store.
NEXT_PUBLIC_LEARNBOX_ALPHA_INVITE_UI_ENABLED=false
LEARNBOX_ALPHA_INVITE_ENABLED=false
# LEARNBOX_ALPHA_INVITE_SECRET=
# LEARNBOX_ALPHA_CONSENT_VERSION=v1

# Owner-only admin passkeys are a separate, disabled-by-default deployment boundary.
LEARNBOX_ADMIN_PASSKEY_ENABLED=false
NEXT_PUBLIC_LEARNBOX_ADMIN_PASSKEY_UI_ENABLED=false
LEARNBOX_ADMIN_BOOTSTRAP_ENABLED=false
# LEARNBOX_ADMIN_ORIGIN=https://admin.example.com
# LEARNBOX_ADMIN_RP_ID=admin.example.com
# LEARNBOX_ADMIN_TOKEN_HASH_KEY=
# LEARNBOX_ADMIN_BOOTSTRAP_SECRET=
