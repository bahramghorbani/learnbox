{
  "name": "@learnbox/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "migrate": "pnpm build && node dist/database/run-migrations.js",
    "typecheck": "pnpm --filter @learnbox/learning-engine build && tsc --noEmit",
    "test": "pnpm --filter @learnbox/learning-engine build && vitest run"
  },
  "dependencies": {
    "@learnbox/learning-engine": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.1.0",
    "@types/pg": "^8.20.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
