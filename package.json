{
  "name": "learnbox",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:dashboard && pnpm test:load && pnpm test:engine-load && pnpm test:mobile-start-content && pnpm verify:mobile-start-content && pnpm verify:mobile-visual-assets && pnpm test:mobile-android-storage && pnpm test:ai-worker-queue && pnpm verify:ai-worker-queue && pnpm verify:security && pnpm verify:ai-continuity && pnpm verify:alpha && pnpm verify:product-config && pnpm verify:client-tier-adapter && pnpm verify:otp-provider-boundary && pnpm verify:sms-ir-adapter && pnpm verify:launch-experience && pnpm verify:start-slice && pnpm verify:start-drafts && pnpm verify:review-gates && pnpm verify:linguistic-approval && pnpm verify:source-scope && pnpm verify:start-provenance-ledger && pnpm verify:start-candidate-qa && pnpm verify:start-pack-v2-contract && pnpm verify:media-handoff && pnpm verify:start-attachment-draft && pnpm verify:start-v2-image-attachment-draft && pnpm verify:start-private-media-attestation && pnpm verify:start-v2-images-private-media-attestation && pnpm verify:private-media-delivery && pnpm verify:start-private-media-upload && pnpm verify:start-v2-images-private-media-upload && pnpm verify:website-start-slice && pnpm verify:start-local-media-preview && pnpm verify:admin-passkey-boundary && pnpm verify:owner-splash-boundary && pnpm verify:alpha-invite-boundary && pnpm verify:production-service-boundaries",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "verify:security": "node scripts/validate-web-security.mjs",
    "verify:ai-continuity": "node scripts/validate-ai-continuity.mjs",
    "test:ai-worker-queue": "node --test scripts/validate-ai-worker-queue.test.mjs",
    "verify:ai-worker-queue": "node scripts/validate-ai-worker-queue.mjs",
    "verify:alpha": "node scripts/validate-closed-alpha.mjs",
    "verify:product-config": "node scripts/validate-product-experience.mjs",
    "verify:client-tier-adapter": "node scripts/validate-client-tier-adapter.mjs",
    "verify:otp-provider-boundary": "node scripts/validate-otp-provider-boundary.mjs",
    "verify:sms-ir-adapter": "node scripts/validate-sms-ir-adapter.mjs",
    "verify:launch-experience": "node scripts/validate-launch-experience.mjs",
    "verify:start-slice": "node scripts/validate-start-slice-candidates.mjs",
    "verify:start-drafts": "node scripts/validate-start-slice-drafts.mjs",
    "verify:review-gates": "node scripts/validate-content-review-gates.mjs",
    "verify:linguistic-approval": "node scripts/validate-start-slice-linguistic-approval.mjs",
    "verify:source-scope": "node scripts/validate-start-slice-source-scope.mjs",
    "verify:start-provenance-ledger": "node scripts/validate-start-slice-provenance-ledger.mjs",
    "verify:start-candidate-qa": "node scripts/validate-start-slice-candidate-qa.mjs",
    "build:media-handoff": "node scripts/build-start-slice-media-handoff.mjs --write",
    "verify:media-handoff": "node scripts/build-start-slice-media-handoff.mjs",
    "build:start-attachment-draft": "node scripts/build-start-slice-attachment-draft.mjs --write",
    "verify:start-attachment-draft": "node scripts/build-start-slice-attachment-draft.mjs",
    "build:start-v2-image-attachment-draft": "node scripts/build-start-v2-image-attachment-draft.mjs --write",
    "verify:start-v2-image-attachment-draft": "node scripts/build-start-v2-image-attachment-draft.mjs",
    "build:start-private-media-attestation": "node scripts/build-start-private-media-attestation.mjs --write",
    "verify:start-private-media-attestation": "node scripts/build-start-private-media-attestation.mjs",
    "build:start-v2-images-private-media-attestation": "node scripts/build-start-private-media-attestation.mjs --v2-images --write",
    "verify:start-v2-images-private-media-attestation": "node scripts/build-start-private-media-attestation.mjs --v2-images",
    "verify:private-media-delivery": "node scripts/validate-private-media-delivery.mjs",
    "verify:admin-passkey-boundary": "node scripts/validate-admin-passkey-boundary.mjs",
    "verify:owner-splash-boundary": "node scripts/validate-owner-splash-boundary.mjs",
    "verify:alpha-invite-boundary": "node scripts/validate-alpha-invite-boundary.mjs",
    "verify:start-private-media-upload": "node scripts/upload-start-slice-private-media.mjs",
    "verify:start-v2-images-private-media-upload": "node scripts/upload-start-slice-private-media.mjs --v2-images",
    "verify:website-start-slice": "node scripts/validate-website-start-slice-staging.mjs",
    "verify:start-local-media-preview": "node scripts/validate-start-slice-local-media-preview.mjs",
    "verify:production-service-boundaries": "node --test infrastructure/production/app/tests/deployment-boundary.test.mjs",
    "test:load": "node --test scripts/load/local-learner-load.test.mjs",
    "test:engine-load": "pnpm --filter @learnbox/learning-engine build && node --test scripts/load/learning-engine-synthetic-load.test.mjs && node scripts/load/learning-engine-synthetic-load.mjs --profile ci",
    "test:mobile-start-content": "node --test scripts/mobile-start-content.test.mjs",
    "test:mobile-android-storage": "node --test scripts/mobile-android-secure-storage.test.mjs",
    "load:local:smoke": "node scripts/load/local-learner-load.mjs --profile smoke",
    "load:local:baseline": "node scripts/load/local-learner-load.mjs --profile baseline",
    "check:avalai": "node scripts/check-avalai-connection.mjs",
    "generate:avalai:bobo-pilot": "node scripts/generate-avalai-bobo-pilot.mjs",
    "generate:avalai:bobo": "node scripts/generate-avalai-bobo-pilot.mjs",
    "generate:avalai:card-pilot": "node scripts/generate-avalai-card-pilot.mjs",
    "generate:avalai:card-candidates": "node scripts/generate-avalai-card-candidates.mjs",
    "verify:start-pack-v2-contract": "node scripts/validate-start-pack-v2-contract.mjs",
    "verify:mobile-start-content": "node scripts/sync-mobile-start-content.mjs --check",
    "verify:mobile-visual-assets": "node scripts/verify-mobile-visual-assets.mjs",
    "generate:avalai:start-pack-v2": "node scripts/generate-avalai-start-pack-v2.mjs",
    "generate:avalai:audio-pilot": "node scripts/generate-avalai-audio-pilot.mjs",
    "generate:avalai:audio-candidates": "node scripts/generate-avalai-audio-candidates.mjs",
    "repair:avalai:audio-candidates": "node scripts/repair-avalai-audio-candidates.mjs",
    "verify:avalai:audio-candidates": "node scripts/verify-avalai-audio-candidates.mjs",
    "dev": "pnpm --filter @learnbox/website dev",
    "dashboard": "node tools/project-dashboard/server.mjs",
    "test:dashboard": "node --test tools/project-dashboard/test/*.test.mjs",
    "preview:web": "pnpm --filter @learnbox/website exec next start --hostname 127.0.0.1 --port 3010"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@next/eslint-plugin-next": "15.5.22",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "next": "^15.4.5",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vercel": "^58.0.0"
  }
}
