# Shape-only values for local config validation. Copy to an ignored app.env on the server and
# replace every placeholder through the server's restricted secret workflow.
DATABASE_URL=postgresql://example:example@example.invalid/learnbox?sslmode=verify-full
LEARNBOX_OTP_SECRET=replace-with-an-independent-32-character-secret
LEARNBOX_SESSION_SECRET=replace-with-a-local-32-character-minimum-secret
LEARNBOX_MOBILE_SESSION_SECRET=replace-with-a-separate-local-32-character-minimum-secret
MOBILE_AUTH_ENABLED=false
LEARNBOX_OTP_TEST_UI_ENABLED=false
SMS_IR_ENABLED=false
SMS_IR_API_KEY=
SMS_IR_TEMPLATE_ID=495140
SMS_IR_CODE_PARAMETER_NAME=OTP
BLOB_READ_WRITE_TOKEN=
LEARNBOX_PRIVATE_MEDIA_ATTACHMENT_ENABLED=false
LEARNBOX_DYNAMIC_SPLASH_ENABLED=false
# Server-backed learner Profile identity read (LB-B03). The Profile endpoint returns 503 while this
# is unset or not exactly "true", which is what kept the learner account surface dark in production.
WEB_LEARNER_PROFILE_ENABLED=false
APP_VERSION=local
# LB-B35 CP4 learning-persistence flags. ALL default off; the two NEXT_PUBLIC_ ones are build-time
# (compose build args), the rest are runtime. Enable one at a time, after review.
LEARNBOX_TZ_PERSIST=false
LEARNBOX_QUEUE_QUARANTINE=false
LEARNBOX_SERVER_SESSION_PLAN=false
LEARNBOX_BINARY_REVIEW=false
LEARNBOX_TODAY_WORKLOAD=false
NEXT_PUBLIC_LEARNBOX_QUEUE_QUARANTINE=false
NEXT_PUBLIC_LEARNBOX_SERVER_SESSION_PLAN=false
