# Shape-only values for local config validation. Copy to an ignored app.env on the server and
# replace every placeholder through the server's restricted secret workflow.
DATABASE_URL=postgresql://example:example@example.invalid/learnbox?sslmode=verify-full
LEARNBOX_OTP_SECRET=replace-with-an-independent-32-character-secret
LEARNBOX_SESSION_SECRET=replace-with-a-local-32-character-minimum-secret
LEARNBOX_MOBILE_SESSION_SECRET=replace-with-a-separate-local-32-character-minimum-secret
MOBILE_AUTH_ENABLED=false
LEARNBOX_OTP_TEST_UI_ENABLED=false
SMS_IR_ENABLED=false
SMS_IR_API_KEY=
SMS_IR_TEMPLATE_ID=495140
SMS_IR_CODE_PARAMETER_NAME=OTP
BLOB_READ_WRITE_TOKEN=
LEARNBOX_PRIVATE_MEDIA_ATTACHMENT_ENABLED=false
LEARNBOX_DYNAMIC_SPLASH_ENABLED=false
# Server-backed learner Profile identity read (LB-B03). The Profile endpoint returns 503 while this
# is unset or not exactly "true", which is what kept the learner account surface dark in production.
WEB_LEARNER_PROFILE_ENABLED=false
APP_VERSION=local
# LB-B35 CP4 learning-persistence flags. The runtime ones default off and are enabled one at a time
# after review. The NEXT_PUBLIC_ ones are build-time (compose build args) and carry the v1.2.2
# release matrix: four activated, binary review UI supplied explicitly by the deploy build.
LEARNBOX_TZ_PERSIST=false
LEARNBOX_QUEUE_QUARANTINE=false
LEARNBOX_SERVER_SESSION_PLAN=false
LEARNBOX_BINARY_REVIEW=false
LEARNBOX_TODAY_WORKLOAD=false
# LB-B35 CP7 GR-1.8 scheduler. Needs migration 0023; with it missing the app refuses reviews (fails closed).
LEARNBOX_SCHEDULER_V2=false
NEXT_PUBLIC_LEARNBOX_QUEUE_QUARANTINE=true
NEXT_PUBLIC_LEARNBOX_SERVER_SESSION_PLAN=true
NEXT_PUBLIC_LEARNBOX_GOAL_UX_REMOVED=true
NEXT_PUBLIC_LEARNBOX_SESSION_EXPIRY_UX=true
NEXT_PUBLIC_LEARNBOX_BINARY_REVIEW_UI=false
# LB-B19: public VAPID key for the daily review-reminder push notification. Empty = the
# reminder toggle stays hidden in Settings (remindersAvailable is still gated on session type,
# but subscribing needs a real key). Not a secret.
# No automated gate enforces this value (see RELEASE_ARTIFACT_PREFLIGHT.md) — every app rebuild
# must set it manually, copied from VAPID_PUBLIC_KEY in notification-worker/.env on the host.
# An omission here already shipped once (2026-10-25) and silently disabled push subscribe with
# no build failure; always diff the shipped bundle for this value before a Production switch.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
