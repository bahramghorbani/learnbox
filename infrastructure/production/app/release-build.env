# Approved non-secret learner build matrix. This is artifact configuration, not runtime configuration.
# Every value is intentionally explicit: NEXT_PUBLIC_* flags are inlined into the shipped client.
# Change needs an owner decision recorded in the PR and a matching affected-feature smoke test.
NEXT_PUBLIC_LEARNBOX_PROFILE_IDENTITY_ENABLED=true
NEXT_PUBLIC_LEARNBOX_QUEUE_QUARANTINE=true
NEXT_PUBLIC_LEARNBOX_SERVER_SESSION_PLAN=true
NEXT_PUBLIC_LEARNBOX_GOAL_UX_REMOVED=true
NEXT_PUBLIC_LEARNBOX_SESSION_EXPIRY_UX=true
NEXT_PUBLIC_LEARNBOX_BINARY_REVIEW_UI=true
