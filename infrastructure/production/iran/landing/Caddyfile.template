(landing_site) {
	encode zstd gzip
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	}
	reverse_proxy landing:3000 {
		health_uri /
		health_interval 30s
		health_timeout 5s
	}
	log {
		output stdout
		format json
	}
}

(learner_app) {
	encode zstd gzip
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	}
	reverse_proxy learner-app:3000 {
		health_uri /
		health_interval 30s
		health_timeout 5s
	}
	log {
		output stdout
		format json
	}
}

(admin_app) {
	encode zstd gzip
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	}
	reverse_proxy admin-app:3000 {
		health_uri /
		health_interval 30s
		health_timeout 5s
	}
	log {
		output stdout
		format json
	}
}

learnboxapp.com {
	@enamad_41346530 path /41346530.txt
	handle @enamad_41346530 {
		root * /config
		file_server
	}
	import landing_site
}

www.learnboxapp.com {
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	}
	redir https://learnboxapp.com{uri} permanent
}

app.learnboxapp.com {
	import learner_app
}

# TEMPORARY CONTAINMENT 2026-09-30 (LB-B30/B31): Admin is fixed-404 until proven safe.
# Owner-approved and reversible: restore the previous block from
# /home/ubuntu/learnbox/evidence/admin-containment-*/Caddyfile.pre-containment then reload.
admin.learnboxapp.com {
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		Cache-Control "no-store"
		X-Robots-Tag "noindex"
	}
	# Out-of-band admin SSH (WebSocket via CDN). Remove this block + reload to disable.
	@lb_ops path /_lb-ops/ssh
	handle @lb_ops {
		basic_auth {
			lbops {$LEARNBOX_OPS_SSH_BCRYPT_HASH}
		}
		reverse_proxy 172.19.0.1:8022
	}
	import admin_app
}
