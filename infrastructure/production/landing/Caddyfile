# Owner-approved and reversible: restore the previous block from
# /home/ubuntu/learnbox/evidence/admin-containment-*/Caddyfile.pre-containment then reload.
admin.learnboxapp.com {
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		Cache-Control "no-store"
		X-Robots-Tag "noindex"
	}
	respond "Not Found" 404
}
