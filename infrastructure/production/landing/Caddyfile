{$SITE_ADDRESS::80} {
    encode zstd gzip

    header {
        -Server
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    }

    reverse_proxy landing:3000 {
        health_uri /
        health_interval 30s
        health_timeout 5s
    }

    log {
        output stdout
        format json
    }
}
