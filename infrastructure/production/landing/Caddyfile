(landing_site) {
	encode zstd gzip
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	}
	reverse_proxy landing:3000 {
		health_uri /
		health_interval 30s
		health_timeout 5s
	}
	log {
		output stdout
		format json
	}
}

(learner_app) {
	encode zstd gzip
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	}
	reverse_proxy learner-app:3000 {
		health_uri /
		health_interval 30s
		health_timeout 5s
	}
	log {
		output stdout
		format json
	}
}

(admin_app) {
	encode zstd gzip
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	}
	reverse_proxy admin-app:3000 {
		health_uri /
		health_interval 30s
		health_timeout 5s
	}
	log {
		output stdout
		format json
	}
}

learnboxapp.com {
	import landing_site
}

www.learnboxapp.com {
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	}
	redir https://learnboxapp.com{uri} permanent
}

app.learnboxapp.com {
	import learner_app
}

